# Copiar a .env.local y completar. NUNCA commitear .env.local.

# Clerk (auth) — keys del dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Modo de auth local (dev-auth-mock, change 2026-08-06-dev-auth-mock).
# En desarrollo local, AUTH_MODE=mock desactiva Clerk y el login se elige entre
# users dev preseteados (requiere seed: npm run db:seed). Vacío/ausente → Clerk.
# En producción es imposible el mock (gate de NODE_ENV).
AUTH_MODE=

# Postgres (Prisma CLI la usa vía prisma.config.ts; la app vía driver adapter)
DATABASE_URL=postgresql://user:password@localhost:5432/ensambla

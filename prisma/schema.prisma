generator client {
  provider = "prisma-client"
  output   = "../src/shared/db/generated"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  Direccion
  Lider
  Colaborador
}

enum Seniority {
  Junior
  SemiSenior
  Senior
}

model Organization {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  members              Member[]
  northStar            NorthStar?
  objectives           Objective[]
  keyResults           KeyResult[]
  teams                Team[]
  teamMembers          TeamMember[]
  projects             Project[]
  projectObjectives    ProjectObjective[]
  skills               Skill[]
  competencies         Competency[]
  skillRequirements    SkillRequirement[]
  enpsMinimumResponses Int                @default(4) @map("enps_minimum_responses")

  @@map("organization")
}

// ─────────────────────────────────────────────────────────────────────────────
// culture-enps (change culture-enps)
// Participation and response are deliberately disconnected (ADR-0005 🔒).
// PulseResponse has no member/auth/participation reference and is immutable in DB.
// ─────────────────────────────────────────────────────────────────────────────

enum PulseScope {
  Organization
  Team
}

enum PulseFrequency {
  Weekly
  Monthly
  Quarterly
}

enum PulseStatus {
  Open
  Closed
}

enum PulseDriver {
  Recognition
  GoalClarity
  CareerGrowth
  Workload
  Coordination
  Other
}

model PulseSchedule {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  scope          PulseScope
  teamId         String?        @map("team_id") @db.Uuid
  frequency      PulseFrequency
  nextRunAt      DateTime       @map("next_run_at") @db.Timestamptz(6)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId])
  @@index([nextRunAt, active])
  @@map("pulse_schedule")
}

model Pulse {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  scope          PulseScope
  teamId         String?     @map("team_id") @db.Uuid
  status         PulseStatus @default(Open)
  openedAt       DateTime    @default(now()) @map("opened_at") @db.Timestamptz(6)
  closesAt       DateTime?   @map("closes_at") @db.Timestamptz(6)
  scheduleId     String?     @map("schedule_id") @db.Uuid
  scheduledFor   DateTime?   @map("scheduled_for") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scheduleId, scheduledFor])
  @@index([organizationId])
  @@index([teamId])
  @@map("pulse")
}

model PulseParticipation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pulseId        String   @map("pulse_id") @db.Uuid
  memberId       String   @map("member_id") @db.Uuid
  responded      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([pulseId, memberId])
  @@index([organizationId])
  @@index([memberId])
  @@map("pulse_participation")
}

model PulseResponse {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  pulseId         String          @map("pulse_id") @db.Uuid
  teamId          String?         @map("team_id") @db.Uuid
  measurementType MeasurementType @map("measurement_type")
  startValue      Decimal         @map("start_value") @db.Decimal(20, 4)
  targetValue     Decimal         @map("target_value") @db.Decimal(20, 4)
  currentValue    Decimal         @map("current_value") @db.Decimal(20, 4)
  checkDone       Boolean?        @map("check_done")
  textState       TextState?      @map("text_state")
  driver          PulseDriver
  comment         String?
  submittedAt     DateTime        @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@index([organizationId])
  @@index([pulseId])
  @@index([teamId])
  @@map("pulse_response")
}

model Member {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id])
  email           String
  name            String
  role            MemberRole
  // Identidad de auth (Clerk). Nullable: un invitado puede no haber logueado aún.
  clerkUserId     String?      @map("clerk_user_id")
  // Insumo del staffing (skills-matrix); nullable: sin dato rankea último.
  seniority       Seniority?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  objectives      Objective[]
  teamMemberships TeamMember[]
  competencies    Competency[]

  @@unique([organizationId, email])
  @@unique([organizationId, clerkUserId])
  @@map("member")
}

// ─────────────────────────────────────────────────────────────────────────────
// strategy-northstar + okrs (change strategy-okrs-core)
// Measurement (ADR-0004) persiste como discriminador + columnas tipadas
// queryables; nunca EAV. `objective` NO tiene columna de progreso: el roll-up
// 🔒 se deriva siempre de los KRs en lectura.
// ─────────────────────────────────────────────────────────────────────────────

enum ObjectiveLevel {
  Company
  Area
  Team
  Person
}

enum ObjectiveStatus {
  Draft
  Published
}

enum MeasurementType {
  Check
  Percentage
  Integer
  Currency
  Text
}

enum TextState {
  NotStarted
  InProgress
  Done
}

model NorthStar {
  id              String          @id @default(uuid()) @db.Uuid
  // UNIQUE: exactamente una North Star por Organización.
  organizationId  String          @unique @map("organization_id") @db.Uuid
  organization    Organization    @relation(fields: [organizationId], references: [id])
  name            String
  measurementType MeasurementType @map("measurement_type")
  startValue      Decimal?        @map("start_value") @db.Decimal(20, 4)
  targetValue     Decimal?        @map("target_value") @db.Decimal(20, 4)
  currentValue    Decimal?        @map("current_value") @db.Decimal(20, 4)
  checkDone       Boolean?        @map("check_done")
  textState       TextState?      @map("text_state")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("north_star")
}

model Objective {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id])
  title          String
  level          ObjectiveLevel
  status         ObjectiveStatus    @default(Draft)
  ownerId        String             @map("owner_id") @db.Uuid
  owner          Member             @relation(fields: [ownerId], references: [id])
  keyResults     KeyResult[]
  projectLinks   ProjectObjective[]
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId])
  @@map("objective")
}

model KeyResult {
  id                String             @id @default(uuid()) @db.Uuid
  // organization_id propio (además del objective) para que la política RLS
  // no dependa de joins.
  organizationId    String             @map("organization_id") @db.Uuid
  organization      Organization       @relation(fields: [organizationId], references: [id])
  objectiveId       String             @map("objective_id") @db.Uuid
  objective         Objective          @relation(fields: [objectiveId], references: [id])
  title             String
  measurementType   MeasurementType    @map("measurement_type")
  startValue        Decimal?           @map("start_value") @db.Decimal(20, 4)
  targetValue       Decimal?           @map("target_value") @db.Decimal(20, 4)
  currentValue      Decimal?           @map("current_value") @db.Decimal(20, 4)
  checkDone         Boolean?           @map("check_done")
  textState         TextState?         @map("text_state")
  skillRequirements SkillRequirement[]
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId])
  @@index([objectiveId])
  @@map("key_result")
}

// ─────────────────────────────────────────────────────────────────────────────
// teams-staffing (change teams-staffing-core)
// Capacity y alertas de alineamiento son SIEMPRE derivadas: sin columnas de
// totales ni flags. RLS en la misma migración (ADR-0003 🔒).
// ─────────────────────────────────────────────────────────────────────────────

enum TeamRole {
  Lead
  Contributor
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  members        TeamMember[]
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id])
  teamId          String       @map("team_id") @db.Uuid
  team            Team         @relation(fields: [teamId], references: [id])
  memberId        String       @map("member_id") @db.Uuid
  member          Member       @relation(fields: [memberId], references: [id])
  role            TeamRole
  capacityPercent Int          @map("capacity_percent")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([teamId, memberId])
  @@index([organizationId])
  @@index([memberId])
  @@map("team_member")
}

model Project {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  organization      Organization       @relation(fields: [organizationId], references: [id])
  name              String
  objectiveLinks    ProjectObjective[]
  skillRequirements SkillRequirement[]
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId])
  @@map("project")
}

model ProjectObjective {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String       @map("project_id") @db.Uuid
  project        Project      @relation(fields: [projectId], references: [id])
  objectiveId    String       @map("objective_id") @db.Uuid
  objective      Objective    @relation(fields: [objectiveId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([projectId, objectiveId])
  @@index([organizationId])
  @@index([objectiveId])
  @@map("project_objective")
}

// ─────────────────────────────────────────────────────────────────────────────
// skills-matrix (change skills-matrix-core)
// Skill por org, Competency (member × skill, level 0–4) y SkillRequirement
// (skill requerida por un Project XOR un KeyResult). RLS en la misma
// migración (ADR-0003 🔒). Sin columnas de flags: gaps/match derivados.
// ─────────────────────────────────────────────────────────────────────────────

model Skill {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id])
  name           String
  competencies   Competency[]
  requirements   SkillRequirement[]
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, name])
  @@map("skill")
}

model Competency {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  memberId       String       @map("member_id") @db.Uuid
  member         Member       @relation(fields: [memberId], references: [id])
  skillId        String       @map("skill_id") @db.Uuid
  skill          Skill        @relation(fields: [skillId], references: [id])
  level          Int
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([memberId, skillId])
  @@index([organizationId])
  @@index([skillId])
  @@map("competency")
}

model SkillRequirement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  skillId        String       @map("skill_id") @db.Uuid
  skill          Skill        @relation(fields: [skillId], references: [id])
  // Exactamente uno de los dos (CHECK en la migración).
  projectId      String?      @map("project_id") @db.Uuid
  project        Project?     @relation(fields: [projectId], references: [id])
  keyResultId    String?      @map("key_result_id") @db.Uuid
  keyResult      KeyResult?   @relation(fields: [keyResultId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([skillId, projectId])
  @@unique([skillId, keyResultId])
  @@index([organizationId])
  @@map("skill_requirement")
}

enum RitualCadence {
  Weekly
  Biweekly
  Monthly
}

enum RitualOccurrenceStatus {
  Scheduled
  Held
  Overdue
}

enum BlockerStatus {
  Open
  Resolved
}

model Ritual {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  teamId         String        @map("team_id") @db.Uuid
  name           String
  cadence        RitualCadence
  startDate      DateTime      @map("start_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId])
  @@index([teamId])
  @@map("ritual")
}

model RitualOccurrence {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  ritualId       String                 @map("ritual_id") @db.Uuid
  scheduledDate  DateTime               @map("scheduled_date") @db.Date
  status         RitualOccurrenceStatus @default(Scheduled)
  heldDate       DateTime?              @map("held_date") @db.Date
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([ritualId, scheduledDate])
  @@index([organizationId])
  @@map("ritual_occurrence")
}

model Blocker {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  teamId         String        @map("team_id") @db.Uuid
  memberId       String        @map("member_id") @db.Uuid
  objectiveId    String?       @map("objective_id") @db.Uuid
  title          String
  description    String?
  status         BlockerStatus @default(Open)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz(6)

  @@index([organizationId])
  @@index([teamId])
  @@index([objectiveId])
  @@index([status])
  @@map("blocker")
}

model Retrospective {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  heldAt         DateTime @map("held_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId])
  @@index([teamId])
  @@map("retrospective")
}
